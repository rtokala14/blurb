{
  "name": "bun-stack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:server": "bun --watch src/server/index.ts",
    "dev:web": "vite",
    "build": "bun run build:web && bun run build:server",
    "build:web": "vite build",
    "build:server": "bun build src/server/index.ts --target bun --outdir dist/server --minify --sourcemap=external",
    "start": "NODE_ENV=production bun dist/server/index.js",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "db:migrate": "bun run src/server/db/migrate.ts up",
    "db:rollback": "bun run src/server/db/migrate.ts down",
    "db:codegen": "kysely-codegen --dialect mssql --out-file src/server/db/schema.generated.ts",
    "check": "bun run typecheck && bun run lint && bun test",
    "check:no-zod": "bun run scripts/check-no-zod.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@elysiajs/eden": "1.4.9",
    "@fontsource-variable/geist": "5.3.0",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.27",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "elysia": "1.4.29",
    "kysely": "0.29.5",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tarn": "3.1.2",
    "tedious": "20.0.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@biomejs/biome": "2.5.8",
    "@happy-dom/global-registrator": "20.11.2",
    "@rolldown/plugin-babel": "0.2.3",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query-devtools": "5.101.4",
    "@tanstack/react-router-devtools": "1.167.1",
    "@tanstack/router-plugin": "1.168.30",
    "@tediousjs/connection-string": "1.1.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/babel__core": "7.20.5",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "babel-plugin-react-compiler": "1.0.0",
    "happy-dom": "20.11.2",
    "kysely-codegen": "0.20.0",
    "shadcn": "4.17.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "@tailwindcss/oxide",
    "esbuild"
  ]
}
