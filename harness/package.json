{
  "name": "blurb-harness",
  "version": "0.1.0",
  "description": "A minimal, high-performance agentic coding harness for Anthropic and OpenAI-compatible APIs",
  "private": true,
  "type": "module",
  "bin": {
    "blurb": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test dist/test/*.test.js",
    "start": "tsc && node dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3"
  }
}
