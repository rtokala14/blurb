# ---- Runtime ----
NODE_ENV=development
PORT=3000
# Where the built SPA lives. Production only; in dev Vite serves it.
CLIENT_DIR=dist/client
# Comma-separated origins allowed to call the API cross-origin.
# Empty means same-origin only, which is how this deploys.
CORS_ORIGINS=

# ---- Database ----
# memory -> in-process store, no database required (default)
# mssql  -> SQL Server / Azure SQL via tedious
DB_DRIVER=memory

# Local SQL Server from docker-compose.dev.yml.
#
# Use the ADO.NET form (what the Azure portal gives you): `bun run db:codegen`
# reads the same variable and only understands that syntax. The URL form
# (mssql://user:pass@host:1433/db?encrypt=true) also works for the app itself.
DATABASE_URL="Server=tcp:localhost,1433;Initial Catalog=app;User ID=sa;Password=Local_Dev_Password1;Encrypt=True;TrustServerCertificate=True"

# Azure SQL — put the real one in a repository/environment secret, not here:
# DATABASE_URL="Server=tcp:your-server.database.windows.net,1433;Initial Catalog=your-database;User ID=your-user;Password=your-password;Encrypt=True;TrustServerCertificate=False"

# Discrete alternative for platforms that inject variables separately.
# DATABASE_URL takes precedence when both are set.
# DB_SERVER=your-server.database.windows.net
# DB_PORT=1433
# DB_NAME=your-database
# DB_USER=your-user
# DB_PASSWORD=your-password
# DB_ENCRYPT=true
# DB_TRUST_SERVER_CERTIFICATE=false

# Connection pool bounds. Keep max at or below what the SQL tier allows.
DB_POOL_MIN=0
DB_POOL_MAX=10
